# ---------------------------------------------------------------------------
# Citify — variables de entorno.
#
# En el VPS viven en /etc/citify/app.env (dueño root, 0640, grupo citify).
# En local: copiar a .env.local.
#
# Las NEXT_PUBLIC_* se congelan en el BUILD: si cambian, hay que re-buildear.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- URLs -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://citify.com.ar
NEXT_PUBLIC_APP_BASE_URL=https://citify.com.ar

# --- Base de datos ----------------------------------------------------------
# Citify comparte la base de Postgres con Countrify (businesses y promotions
# viven en el schema `shared`). La app corre con citify_app (solo DML); las
# migraciones con citify_admin via DB_ADMIN_USER / DB_ADMIN_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=countrify
DB_USER=citify_app
DB_PASSWORD=
# Solo el valor literal 'disable' apaga TLS. Contra el Postgres local del VPS
# tiene que ser 'disable'.
DB_SSL=disable
# search_path = <DB_SCHEMA>, shared, public
DB_SCHEMA=citify
DB_POOL_MAX=5
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000

# Solo para scripts/db/migrate.mjs (DDL = dueño del schema):
# DB_ADMIN_USER=citify_admin
# DB_ADMIN_PASSWORD=

# --- Sesion -----------------------------------------------------------------
# HMAC de la cookie citify_session. openssl rand -base64 48
APP_SESSION_SECRET=

# --- Almacenamiento (S3-compatible: Garage en el VPS) ------------------------
# S3_ENDPOINT tiene que ser el host PUBLICO con el que pega el navegador: la
# firma de la URL prefirmada se calcula sobre ese host.
S3_ENDPOINT=https://s3.citify.com.ar
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dos buckets: el acceso publico es por bucket, no por prefijo.
S3_PUBLIC_BUCKET=citify-public
S3_PRIVATE_BUCKET=citify-private
S3_PUBLIC_BASE_URL=https://archivos.citify.com.ar

# --- Email (Resend) ---------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Citify <no-reply@citify.com.ar>
RESEND_WEBHOOK_SECRET=
# Solo en local, para probar el webhook sin firma. Nunca en produccion.
# ALLOW_UNSIGNED_EMAIL_WEBHOOK=true
CONTACT_DESTINATION_EMAIL=

# --- Web Push (VAPID) -------------------------------------------------------
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:soporte@citify.com.ar

# --- IA (OpenRouter) --------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# IADMIN_AI_MODEL=

# --- Cron -------------------------------------------------------------------
# Header X-Cron-Secret de /api/cron/*. openssl rand -hex 32
CRON_SECRET=
