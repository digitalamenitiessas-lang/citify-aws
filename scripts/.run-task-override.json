{
  "containerOverrides": [
    {
      "name": "citify-web",
      "command": [
        "node",
        "-e",
        "const fs=require('fs');function find(dir,depth){if(depth>4)return [];try{return fs.readdirSync(dir).filter(d=>d.includes('cognito')||d.includes('@aws-sdk')).map(d=>dir+'/'+d).concat(...fs.readdirSync(dir).filter(d=>{try{return fs.statSync(dir+'/'+d).isDirectory()&&d!=='node_modules'&&!d.startsWith('.')}catch(e){return false}}).map(d=>find(dir+'/'+d,depth+1)))}catch(e){return []}};console.log(find('/app/node_modules',0).slice(0,30));console.log('---');console.log(find('/app/node_modules/@aws-sdk',0).slice(0,30))"
      ]
    }
  ]
}
